{
  "name": "shopos",
  "version": "0.1.0",
  "private": true,
  "description": "ShopOS - Retail POS + Stock Management + Online Sales SaaS for Ireland",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,css}\" --ignore-path .gitignore",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,css}\" --ignore-path .gitignore",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:install": "PLAYWRIGHT_HOST_PLATFORM_OVERRIDE=${PLAYWRIGHT_HOST_PLATFORM_OVERRIDE:-ubuntu24.04-x64} playwright install chromium",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx src/db/seed.ts",
    "db:seed:auth": "tsx --env-file=.env.local src/db/seed-auth.ts",
    "db:seed:roles": "tsx --env-file=.env.local src/db/seed-extra-roles.ts",
    "db:seed:needscarlow": "tsx --env-file=.env.local src/db/seed-needscarlow.ts",
    "db:seed:needscarlow:misc": "tsx --env-file=.env.local src/db/seed-needscarlow-misc.ts",
    "db:seed:needscarlow:vegetables": "tsx --env-file=.env.local src/db/seed-needscarlow-vegetables.ts",
    "db:seed:platform": "tsx --env-file=.env.local src/db/seed-platform-superadmins.ts",
    "db:seed:susu552813": "tsx --env-file=.env.local src/db/seed-susu552813.ts",
    "db:combine-migrations": "node scripts/combine-migrations.mjs",
    "db:push:remote": "node --env-file=.env.local scripts/push-migrations-api.mjs",
    "test:auth": "node scripts/test-auth-flow.mjs",
    "test:onboarding": "node scripts/test-onboarding-flow.mjs",
    "test:onboarding:app": "node scripts/test-onboarding-via-app.mjs",
    "test:catalog": "node scripts/test-catalog-flow.mjs",
    "test:pos": "node scripts/test-pos-flow.mjs",
    "test:sessions": "node scripts/test-sessions-flow.mjs",
    "test:purchasing": "node scripts/test-purchasing-flow.mjs",
    "test:reports": "node scripts/test-reports-flow.mjs",
    "test:audit": "node scripts/test-audit-flow.mjs",
    "test:online-store": "node scripts/test-online-store-flow.mjs",
    "test:offline": "tsx scripts/test-offline-pos.mjs",
    "backup": "node scripts/backup-db.mjs",
    "desktop:install": "npm install --prefix apps/desktop",
    "desktop:dev": "npm run desktop:install && SHOPOS_APP_URL=http://localhost:3000 npm run dev --prefix apps/desktop",
    "desktop:build:win": "npm run desktop:install && npm run build:win --prefix apps/desktop",
    "desktop:pack": "npm run desktop:install && npm run pack --prefix apps/desktop",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:status": "supabase status",
    "supabase:reset": "supabase db reset",
    "prepare": "husky"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.105.4",
    "@tanstack/react-query": "^5.100.10",
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "csv-parse": "^5.6.0",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "drizzle-orm": "^0.45.2",
    "idb": "^8.0.3",
    "lucide-react": "^1.16.0",
    "nanoid": "^5.1.11",
    "next": "^16.2.6",
    "next-safe-action": "^8.5.2",
    "next-themes": "^0.4.6",
    "postgres": "^3.4.9",
    "radix-ui": "^1.4.3",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-hook-form": "^7.76.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@serwist/turbopack": "^9.5.11",
    "@tailwindcss/postcss": "^4.3.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.8.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.2",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.28.0",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.6",
    "fake-indexeddb": "^6.2.5",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.0.5",
    "postcss": "^8.5.14",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "serwist": "^9.5.11",
    "supabase": "^2.105.0",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.22.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.6"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  }
}
